{
  "name": "monorepo-template",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch build",
    "check:pkg": "turbo run check:pkg",
    "test": "turbo run test",
    "version": "changeset version",
    "tag": "changeset tag",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spell": "cspell .",
    "commitlint": "commitlint --edit"
  },
  "//": {
    "scripts.publish:npm": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@changesets/cli": "catalog:workspace",
    "@commitlint/cli": "catalog:commit",
    "@commitlint/config-conventional": "catalog:commit",
    "cspell": "catalog:lint",
    "eslint": "catalog:lint",
    "lefthook": "catalog:hooks",
    "turbo": "catalog:workspace"
  }
}
