{
  "name": "@mono/hooks-vue",
  "type": "module",
  "version": "0.1.0",
  "description": "hooks 域 vue 场景逻辑复用包",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./iframe/vue-router": {
      "import": {
        "types": "./dist/iframe/vue-router.d.mts",
        "default": "./dist/iframe/vue-router.mjs"
      },
      "require": {
        "types": "./dist/iframe/vue-router.d.cts",
        "default": "./dist/iframe/vue-router.cjs"
      }
    },
    "./keep-alive/vue-router": {
      "import": {
        "types": "./dist/keep-alive/vue-router.d.mts",
        "default": "./dist/keep-alive/vue-router.mjs"
      },
      "require": {
        "types": "./dist/keep-alive/vue-router.d.cts",
        "default": "./dist/keep-alive/vue-router.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check:pkg": "publint && attw --pack . --exclude-entrypoints './iframe/vue-router' './keep-alive/vue-router' && attw --pack . --entrypoints './iframe/vue-router' './keep-alive/vue-router' --profile esm-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:check",
    "publint": "catalog:check",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:test",
    "vue": "catalog:web",
    "vue-router": "catalog:web"
  }
}
