{
  "name": "@mono/ui-vue",
  "type": "module",
  "version": "0.1.0",
  "description": "UI 域 vue 场景组件包",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:check",
    "@tsdown/css": "catalog:build",
    "@vitejs/plugin-vue": "catalog:build",
    "publint": "catalog:check",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "unplugin-vue": "catalog:build",
    "vitest": "catalog:test",
    "vue": "catalog:web",
    "vue-tsc": "catalog:build"
  }
}
