{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // vue 场景包需要 DOM 类型；base 不携带 DOM，避免污染 Node/工具域包
    // Vue SFC 的模板展开代码无法满足 isolatedDeclarations（d.ts 由 vue-tsc 生成而非 oxc），此处关闭
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "isolatedDeclarations": false
  },
  "include": ["src"]
}
